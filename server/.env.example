PORT=9000

# Collection names (must match the ones created in mongo/mongoBot.js)
COLL_USERS=Users
COLL_POIS=POIs
COLL_VISITS=Visits
COLL_CASES=Cases

# Time constants
MILISEC_IN_A_DAY=86400000
MINS_IN_A_DAY=1440

# Data generator tuning (values below are guesses - adjust)
CASE_DAYS_EXLUDE=14      # days around a case in which the same user can't get another case
CASES_PERCENTAGE=1       # read with parseInt(), so fractions like 0.33 become 0
VISITS_PER_USER=10
NIGHT_OUT_START=1080     # minutes after midnight when a generated day starts
MAX_DISTANCE=1000        # metres, added to a base of 1000 when picking the next POI
WALK_SPEED=80            # metres per minute
MIN_STAY_TIME=10         # minutes
MAX_STAY_TIME=120        # minutes
